# Copy to .env and fill in.
#
# Leave ANTHROPIC_API_KEY blank to run on cached fixtures (the demo is
# offline-safe by default). To run LIVE, set the key AND make sure
# MOCK_MODE is not 1 - it is checked first and short-circuits the key,
# so `MOCK_MODE=1` with a valid key still runs offline.
ANTHROPIC_API_KEY=

# Uncomment to force offline mode even when a key is present:
# MOCK_MODE=1

# Warehouse seam (optional). Set ONE line; the value is a SQLAlchemy URL. Never commit .env.
#   used by:  python -m ops.warehouse smoke | load | verify   (and as a default for --url)
# RATIONALE_WAREHOUSE_URL=snowflake://USER:PASS@ORG-ACCOUNT/RATIONALE/PUBLIC?warehouse=COMPUTE_WH&role=ACCOUNTADMIN
# RATIONALE_WAREHOUSE_URL=databricks://token:TOKEN@HOST?http_path=/sql/1.0/warehouses/ID&catalog=main&schema=rationale
#   then, to run the app against it (pick one):
# RATIONALE_OMS_DSN=<same url>      # order system fetched live; DuckDB stays the engine
# RATIONALE_DB=<same url>           # the whole contract executed on the warehouse

# Copy to .env and fill in.
#
# Leave ANTHROPIC_API_KEY blank to run on cached fixtures (the demo is
# offline-safe by default). To run LIVE, set the key AND make sure
# MOCK_MODE is not 1 - it is checked first and short-circuits the key,
# so `MOCK_MODE=1` with a valid key still runs offline.
ANTHROPIC_API_KEY=

# Uncomment to force offline mode even when a key is present:
# MOCK_MODE=1

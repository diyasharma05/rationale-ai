# secrets — never commit
.env

# python
__pycache__/
*.pyc
.venv/
venv/

# The seeded dataset IS committed (~5 MB): it makes `git clone && streamlit run`
# work with no build step, and keeps hosted deploys from generating data at
# boot. Regenerate any time with `python data/generate_data.py`.
data/state/

# local scratch
st_out.txt
st_err.txt

# local documents (remove these lines if you want them in the repo)
*.pptx
*.pdf
VIDEO_SCRIPT.md

# eval.py's throwaway ledger (the scored results themselves are tracked at
# data/eval_results.json so the UI panel survives a fresh clone)
data/state/_eval/

# live ingestion lane (ops/ingest.py) — runtime scratch, never committed
data/live/
*.docx

# local PostgreSQL instance (python -m ops.pg_local init): runtime data, never committed
data/pg/
data/state/_bench/
# BI hand-off (python -m ops.export_bi): regenerated on demand
data/exports/
